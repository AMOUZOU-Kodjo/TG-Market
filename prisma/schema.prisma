generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ───────────────────────────────────────────

enum UserRole {
  user
  admin
}

enum ProductCondition {
  new
  like_new
  good
  fair
  poor
}

enum ProductStatus {
  active
  sold
  expired
  deleted
}

enum VehicleType {
  car
  moto
}

enum ConversationType {
  text
  image
  offer
  system
}

enum TransactionType {
  sale
  purchase
  withdrawal
  deposit
  refund
}

enum TransactionStatus {
  completed
  pending
  failed
}

enum EscrowStatus {
  pending
  paid
  pending_delivery
  delivered
  completed
  disputed
  refunded
  cancelled
}

enum PaymentProvider {
  flooz
  tmoney
  mobile_money
  card
}

enum KycDocumentType {
  cni
  peris
  passeport
}

enum KycStatus {
  pending
  approved
  rejected
}

enum ProfileVisibility {
  public
  contacts
  private
}

enum OfferStatus {
  pending
  accepted
  rejected
  cancelled
  countered
}

// ─── TABLES ──────────────────────────────────────────

model User {
  id                   Int                 @id @default(autoincrement())
  first_name           String              @db.VarChar(50)
  last_name            String              @db.VarChar(50)
  email                String              @unique @db.VarChar(255)
  phone                String              @unique @db.VarChar(20)
  password             String              @db.VarChar(255)
  avatar               String?             @db.VarChar(500)
  bio                  String?             @db.VarChar(200)
  city                 String              @db.VarChar(100)
  district             String?             @db.VarChar(100)
  role                 UserRole            @default(user)
  email_verified_at    DateTime?
  phone_verified_at    DateTime?
  identity_verified    Boolean             @default(false)
  is_professional      Boolean             @default(false)
  is_trusted           Boolean             @default(false)
  preferred_language   String              @default("fr") @db.VarChar(5)
  preferred_currency   String              @default("FCFA") @db.VarChar(5)
  notifications_email  Boolean             @default(true)
  notifications_push   Boolean             @default(true)
  notifications_sms    Boolean             @default(false)
  profile_visibility   ProfileVisibility   @default(public)
  show_phone           Boolean             @default(false)
  show_location        Boolean             @default(true)
  rating_avg           Float               @default(0)
  review_count         Int                 @default(0)
  product_count        Int                 @default(0)
  follower_count       Int                 @default(0)
  following_count      Int                 @default(0)
  is_active            Boolean             @default(true)
  created_at           DateTime            @default(now())
  updated_at           DateTime            @updatedAt

  products             Product[]
  conversations        ConversationParticipant[]
  messages_sent        Message[]
  notifications        Notification[]
  wallet_transactions  WalletTransaction[]
  escrow_as_buyer      EscrowTransaction[]   @relation("EscrowBuyer")
  escrow_as_seller     EscrowTransaction[]   @relation("EscrowSeller")
  reviews_given        Review[]              @relation("ReviewReviewer")
  reviews_received     Review[]              @relation("ReviewSeller")
  favorites            Favorite[]
  follows_followers    Follow[]              @relation("FollowFollower")
  follows_following    Follow[]              @relation("FollowFollowing")
  kyc_verifications    KycVerification[]
  kyc_reviewed         KycVerification[]     @relation("KycReviewer")
  user_badges          UserBadge[]
  payment_methods      PaymentMethod[]
  product_views        ProductView[]
  refresh_tokens       RefreshToken[]
  offers_received      Offer[]               @relation("OfferSeller")
  offers_made          Offer[]               @relation("OfferBuyer")
  bundles              Bundle[]

  @@index([city])
  @@index([created_at])
  @@index([is_active, role])
}

model RefreshToken {
  id           Int      @id @default(autoincrement())
  user_id      Int
  token        String   @unique @db.Text
  user_agent   String?  @db.VarChar(500)
  ip_address   String?  @db.VarChar(45)
  expires_at   DateTime
  created_at   DateTime @default(now())

  user         User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([token])
  @@index([expires_at])
}

model Category {
  id            Int       @id @default(autoincrement())
  name          String    @unique @db.VarChar(100)
  slug          String    @unique @db.VarChar(100)
  icon          String    @db.VarChar(50)
  color         String    @db.VarChar(7)
  description   String?   @db.Text
  image         String?   @db.VarChar(500)
  parent_id     Int?
  product_count Int       @default(0)
  sort_order    Int       @default(0)
  is_active     Boolean   @default(true)
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  parent    Category?  @relation("CategoryTree", fields: [parent_id], references: [id])
  children  Category[] @relation("CategoryTree")
  products  Product[]

  @@index([slug])
  @@index([parent_id])
  @@index([is_active, sort_order])
}

model Product {
  id                     Int            @id @default(autoincrement())
  user_id                Int
  category_id            Int
  title                  String         @db.VarChar(100)
  description            String         @db.Text
  price                  Int
  original_price         Int?
  condition              ProductCondition
  brand                  String?        @db.VarChar(50)
  city                   String         @db.VarChar(100)
  neighborhood           String?        @db.VarChar(100)
  negotiable             Boolean        @default(false)
  delivery_available     Boolean        @default(false)
  delivery_price         Int?
  views                  Int            @default(0)
  favorites_count        Int            @default(0)
  is_urgent              Boolean        @default(false)
  is_promoted            Boolean        @default(false)
  is_featured            Boolean        @default(false)
  status                 ProductStatus  @default(active)
  latitude               Decimal?       @db.Decimal(10, 7)
  longitude              Decimal?       @db.Decimal(10, 7)
  has_active_negotiation Boolean        @default(false)
  search_vector          Unsupported("tsvector")?
  created_at             DateTime       @default(now())
  updated_at             DateTime       @updatedAt

  user                User                  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  category            Category              @relation(fields: [category_id], references: [id])
  images              ProductImage[]
  tags                ProductTag[]
  specifications      ProductSpec[]
  vehicle             Vehicle?
  conversations       Conversation[]
  notifications       Notification[]
  escrow_transactions EscrowTransaction[]
  reviews             Review[]
  favorites           Favorite[]
  views_log           ProductView[]
  offers              Offer[]
  bundle_items        BundleItem[]

  @@index([user_id])
  @@index([category_id])
  @@index([city])
  @@index([status])
  @@index([created_at])
  @@index([price])
  @@index([status, created_at])
}

model ProductImage {
  id         Int      @id @default(autoincrement())
  product_id Int
  url        String   @db.VarChar(500)
  sort_order Int      @default(0)
  created_at DateTime @default(now())

  product    Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@index([product_id])
}

model ProductTag {
  id         Int     @id @default(autoincrement())
  product_id Int
  tag        String  @db.VarChar(50)

  product    Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@unique([product_id, tag])
  @@index([tag])
}

model ProductSpec {
  id         Int     @id @default(autoincrement())
  product_id Int
  label      String  @db.VarChar(100)
  value      String  @db.VarChar(255)

  product    Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@index([product_id])
}

model Vehicle {
  id               Int        @id @default(autoincrement())
  product_id       Int        @unique
  type             VehicleType
  brand            String     @db.VarChar(50)
  model            String     @db.VarChar(50)
  year             Int
  mileage          Int
  fuel             String     @db.VarChar(20)
  transmission     String     @db.VarChar(20)
  engine_size      String?    @db.VarChar(20)
  horsepower       Int?
  color            String?    @db.VarChar(30)
  owners           Int?
  doc_carte_grise  Boolean    @default(false)
  doc_insurance    Boolean    @default(false)
  doc_inspection   Boolean    @default(false)
  created_at       DateTime   @default(now())
  updated_at       DateTime   @updatedAt

  product          Product    @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@index([brand, model])
  @@index([type])
  @@index([year])
}

model Conversation {
  id            Int                       @id @default(autoincrement())
  product_id    Int?
  created_at    DateTime                  @default(now())
  updated_at    DateTime                  @updatedAt

  product       Product?                  @relation(fields: [product_id], references: [id], onDelete: SetNull)
  participants  ConversationParticipant[]
  messages      Message[]

  @@index([updated_at])
}

model ConversationParticipant {
  id              Int          @id @default(autoincrement())
  conversation_id Int
  user_id         Int
  last_read_at     DateTime?
  unread_count     Int          @default(0)
  deleted_at       DateTime?
  last_cleared_at  DateTime?
  created_at       DateTime     @default(now())

  conversation    Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([conversation_id, user_id])
  @@index([user_id])
}

model Message {
  id              Int              @id @default(autoincrement())
  conversation_id Int
  sender_id       Int
  text            String           @db.Text
  type            ConversationType @default(text)
  metadata        Json?
  deleted_at      DateTime?
  deleted_by_ids  Int[]            @default([])
  created_at      DateTime         @default(now())

  conversation    Conversation     @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  sender          User             @relation(fields: [sender_id], references: [id], onDelete: Cascade)

  @@index([conversation_id, created_at])
  @@index([sender_id])
}

model Notification {
  id          Int      @id @default(autoincrement())
  user_id     Int
  type        String   @db.VarChar(50)
  title       String   @db.VarChar(255)
  description String   @db.Text
  product_id  Int?
  read        Boolean  @default(false)
  metadata    Json?
  created_at  DateTime @default(now())

  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [product_id], references: [id], onDelete: SetNull)

  @@index([user_id, read, created_at])
}

model WalletTransaction {
  id             Int               @id @default(autoincrement())
  user_id        Int
  type           TransactionType
  amount         Int
  description    String            @db.VarChar(255)
  counterparty   String?           @db.VarChar(100)
  status         TransactionStatus @default(completed)
  reference_type String?           @db.VarChar(50)
  reference_id   Int?
  created_at     DateTime          @default(now())

  user           User              @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, created_at])
}

model EscrowTransaction {
  id             Int          @id @default(autoincrement())
  product_id     Int
  buyer_id       Int
  seller_id      Int
  amount         Int
  fee            Int
  status         EscrowStatus @default(pending)
  payment_method String?      @db.VarChar(30)
  confirmed_at   DateTime?
  released_at    DateTime?
  disputed_at       DateTime?
  dispute_reason    String?      @db.Text
  confirmation_token String?     @db.VarChar(64)
  created_at        DateTime     @default(now())
  updated_at     DateTime     @updatedAt

  product        Product      @relation(fields: [product_id], references: [id])
  buyer          User         @relation("EscrowBuyer", fields: [buyer_id], references: [id])
  seller         User         @relation("EscrowSeller", fields: [seller_id], references: [id])
  reviews        Review[]

  @@index([buyer_id])
  @@index([seller_id])
  @@index([status])
  @@index([created_at])
}

model PaymentMethod {
  id               Int             @id @default(autoincrement())
  user_id          Int
  provider         PaymentProvider
  provider_user_id String?         @db.VarChar(100)
  label            String?         @db.VarChar(100)
  is_default       Boolean         @default(false)
  is_active        Boolean         @default(true)
  created_at       DateTime        @default(now())

  user             User            @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

model Review {
  id          Int      @id @default(autoincrement())
  reviewer_id Int
  seller_id   Int
  product_id  Int?
  escrow_id   Int?
  rating      Int      @db.SmallInt
  comment     String   @db.Text
  created_at  DateTime @default(now())

  reviewer    User               @relation("ReviewReviewer", fields: [reviewer_id], references: [id])
  seller      User               @relation("ReviewSeller", fields: [seller_id], references: [id])
  product     Product?           @relation(fields: [product_id], references: [id], onDelete: SetNull)
  escrow      EscrowTransaction? @relation(fields: [escrow_id], references: [id])

  @@unique([reviewer_id, escrow_id])
  @@index([seller_id])
  @@index([created_at])
}

model Favorite {
  id         Int      @id @default(autoincrement())
  user_id    Int
  product_id Int
  created_at DateTime @default(now())

  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@unique([user_id, product_id])
  @@index([product_id])
}

model Follow {
  id           Int      @id @default(autoincrement())
  follower_id  Int
  following_id Int
  created_at   DateTime @default(now())

  follower     User     @relation("FollowFollower", fields: [follower_id], references: [id], onDelete: Cascade)
  following    User     @relation("FollowFollowing", fields: [following_id], references: [id], onDelete: Cascade)

  @@unique([follower_id, following_id])
  @@index([following_id])
}

model KycVerification {
  id                 Int             @id @default(autoincrement())
  user_id            Int
  document_type      KycDocumentType
  document_front_url String          @db.VarChar(500)
  document_back_url  String?         @db.VarChar(500)
  selfie_url         String          @db.VarChar(500)
  status             KycStatus       @default(pending)
  rejection_reason   String?         @db.Text
  reviewed_by        Int?
  submitted_at       DateTime        @default(now())
  reviewed_at        DateTime?
  created_at         DateTime        @default(now())
  updated_at         DateTime        @updatedAt

  user               User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  reviewer           User?           @relation("KycReviewer", fields: [reviewed_by], references: [id])

  @@index([status])
  @@index([user_id])
}

model UserBadge {
  id        Int      @id @default(autoincrement())
  user_id   Int
  badge_key String   @db.VarChar(50)
  earned_at DateTime @default(now())

  user      User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, badge_key])
}

model Faq {
  id         Int      @id @default(autoincrement())
  question   String   @db.VarChar(500)
  answer     String   @db.Text
  category   String   @db.VarChar(50)
  sort_order Int      @default(0)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([category, is_active])
}

model ProductView {
  id         Int      @id @default(autoincrement())
  product_id Int
  user_id    Int?
  ip_address String?  @db.VarChar(45)
  user_agent String?  @db.VarChar(500)
  created_at DateTime @default(now())

  product    Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([product_id, created_at])
  @@index([user_id])
}

model Offer {
  id               Int          @id @default(autoincrement())
  product_id       Int
  buyer_id         Int
  seller_id        Int
  amount           Int
  status           OfferStatus  @default(pending)
  message          String?      @db.VarChar(500)
  countered_amount Int?
  created_at       DateTime     @default(now())
  updated_at       DateTime     @updatedAt

  product          Product      @relation(fields: [product_id], references: [id])
  buyer            User         @relation("OfferBuyer", fields: [buyer_id], references: [id])
  seller           User         @relation("OfferSeller", fields: [seller_id], references: [id])

  @@index([product_id])
  @@index([buyer_id])
  @@index([seller_id])
  @@index([status])
}

model Bundle {
  id          Int          @id @default(autoincrement())
  seller_id   Int
  title       String       @db.VarChar(100)
  description String?      @db.Text
  total_price Int
  bundle_price Int
  status      String       @default("active") @db.VarChar(20)
  created_at  DateTime     @default(now())
  updated_at  DateTime     @updatedAt

  seller      User         @relation(fields: [seller_id], references: [id])
  items       BundleItem[]

  @@index([seller_id])
  @@index([status])
}

model BundleItem {
  id         Int      @id @default(autoincrement())
  bundle_id  Int
  product_id Int

  bundle     Bundle   @relation(fields: [bundle_id], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [product_id], references: [id])

  @@unique([bundle_id, product_id])
  @@index([bundle_id])
  @@index([product_id])
}

model SiteSetting {
  key        String   @id
  value      String   @db.Text
  updated_at DateTime @updatedAt
}
