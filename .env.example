# Server
PORT=3000
NODE_ENV=development
API_PREFIX=/api

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tg_market"

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-256-bit-secret-min-32-chars
JWT_REFRESH_SECRET=your-256-bit-refresh-secret-min-32
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=30d

# Cloudflare R2
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=tg-market-assets
R2_PUBLIC_URL=https://assets.tgmarket.tg

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@tgmarket.tg
SMTP_PASS=your_smtp_password
SMTP_FROM="TG-Market <noreply@tgmarket.tg>"

# SMS (Togocel)
SMS_API_URL=https://api.togocel.tg/sms/send
SMS_API_KEY=your_sms_api_key
SMS_SENDER=TG-MARKET

# Frontend
FRONTEND_URL=http://localhost:5173

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Flutterwave
FLUTTERWAVE_PUBLIC_KEY=your_flutterwave_public_key
FLUTTERWAVE_SECRET_KEY=your_flutterwave_secret_key
FLUTTERWAVE_ENCRYPTION_KEY=your_flutterwave_encryption_key
FLUTTERWAVE_WEBHOOK_SECRET=your_flutterwave_webhook_secret

# Direct Operator APIs (tentative Flooz → Flutterwave → manuel)
FLOOZ_API_URL=votre_url_api_flooz
FLOOZ_API_KEY=votre_cle_api_flooz
FLOOZ_MERCHANT_ID=votre_merchant_id_flooz
TMONEY_API_URL=votre_url_api_tmoney
TMONEY_API_KEY=votre_cle_api_tmoney

# Platform Mobile Money Accounts (fallback manuel)
FLOOZ_ACCOUNT_NUMBER=+228 90 00 00 01
TMONEY_ACCOUNT_NUMBER=+228 90 00 00 02
