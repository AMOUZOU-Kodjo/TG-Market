{
  "name": "tg-market-api",
  "version": "1.0.0",
  "description": "API Backend pour TG-Market — Marketplace de seconde main au Togo",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "prisma migrate deploy && node src/index.js",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "node prisma/seed.js",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "lint": "eslint src/"
  },
  "keywords": [
    "marketplace",
    "togo",
    "tg-market"
  ],
  "author": "AMOUZOU Kodjo & AWOUGNO Kofi Yosua",
  "license": "ISC",
  "dependencies": {
